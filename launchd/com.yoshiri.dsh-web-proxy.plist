<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yoshiri.dsh-web-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/yoshiri/.local/bin/tcp-proxy.py</string>
    <string>--listen</string>
    <string><TAILSCALE_IP>:3080</string>
    <string>--target</string>
    <string>127.0.0.1:3081</string>
  </array>
  <key>StandardOutPath</key>
  <string>/private/tmp/dsh-web-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/dsh-web-proxy.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
